GAMS 51.4.0  91cb996b Nov 10, 2025          WEX-WEI x86 64bit/MS Windows - 10/20/26 15:25:02 Page 1
ERCOT 365-Day Net Renewable Generation & Dispatch Optimization
C o m p i l a t i o n


   2   
   3  Sets
   4      d 'Days of the year (365 days)' / d1*d365 /
   5      g 'Thermal units'               / g1*g5 /;
   6   
   7  Parameters
   8      TotalLoad(d)  'Total ERCOT Load (MW)'
   9      WindCap(d)    'Available Wind Generation (MW)'
  10      SolarCap(d)   'Available Solar Generation (MW)';
  11   
  12  * --- 1. 365-DAY ANNUAL PROFILE INITIALIZATION ---
  13  loop(d,
  14      TotalLoad(d) = 43000 + 4000 * sin(ord(d) * 2 * pi / 365) + 1500 * cos(ord(d) * 4 * pi / 365);
  15      WindCap(d)   = 14.0  + 4.5  * cos(ord(d) * 2 * pi / 365);
  16      SolarCap(d)  = 26.0  + 9.0  * sin(ord(d) * 2 * pi / 365);
  17  );
  18   
  19  * --- 2. GENERATOR PARAMETERS ---
  20  Parameters
  21      Pmin(g)  'Thermal unit minimum limits (MW)'   / g1 30, g2 25, g3 15, g4 10, g5 10 /
  22      Pmax(g)  'Thermal unit maximum limits (MW)'   / g1 200, g2 150, g3 100, g4 70, g5 40 /
  23      b(g)     'Thermal marginal cost ($/MWh)'      / g1 18, g2 28, g3 35, g4 18, g5 25 /
  24   
  25      CurtailPenalty 'Curtailment penalty cost ($/MWh)' / 50.0 /;
  26   
  27  Variables
  28      Z                 'Total annual system operating cost ($)'
  29      P_thermal(g,d)    'Thermal generation (MW)'
  30      P_wind(d)         'Optimized Wind generation (MW)'
  31      P_solar(d)        'Optimized Solar generation (MW)'
  32      Curtail_wind(d)   'Wind curtailment (MW)'
  33      Curtail_solar(d)  'Solar curtailment (MW)';
  34   
  35  * --- 3. VARIABLE BOUNDS ---
  36  P_thermal.lo(g,d) = Pmin(g);
  37  P_thermal.up(g,d) = Pmax(g);
  38   
  39  P_wind.lo(d)  = 0;
  40  P_wind.up(d)  = WindCap(d);
  41   
  42  P_solar.lo(d) = 0;
  43  P_solar.up(d) = SolarCap(d);
  44   
  45  Equations
  46      cost_obj             'Objective function with curtailment penalties'
  47      power_balance(d)     'Overall system power balance'
  48      wind_curtail_calc(d) 'Wind curtailment tracking'
  49      solar_curtail_calc(d)'Solar curtailment tracking';
  50   
  51  * --- 4. EQUATION DEFINITIONS ---
  52  cost_obj..
  53      Z =E= sum((g,d), b(g) * P_thermal(g,d))
  54          + sum(d, CurtailPenalty * (Curtail_wind(d) + Curtail_solar(d)));
  55   
  56  power_balance(d)..
  57      sum(g, P_thermal(g,d)) + P_wind(d) + P_solar(d) =E= TotalLoad(d);
  58   
  59  wind_curtail_calc(d)..
  60      Curtail_wind(d) =E= WindCap(d) - P_wind(d);
  61   
  62  solar_curtail_calc(d)..
  63      Curtail_solar(d) =E= SolarCap(d) - P_solar(d);
  64   
  65  * --- 5. SOLVE MODEL USING CBC ---
  66  Model ercot_renewable_opt / all /;
  67  Option lp = cbc;
  68  Option reslim = 300;
  69   
  70  Solve ercot_renewable_opt using lp minimizing Z;
  71   
  72  * --- 6. DISPLAY & CSV EXPORT (Using v2 filename to avoid file locks) ---
  73  Display P_wind.l, P_solar.l, Curtail_wind.l, Curtail_solar.l, Z.l;
  74   
  75  File results / ercot_365day_results_v2.csv /;
  76  results.pw = 32767;
  77  put results;
  78  put "Day,TotalLoad,WindAvail,WindDispatched,WindCurtail,SolarAvail,SolarDispatched,SolarCurtail" /;
  79  loop(d,
  80      put d.tl:0, ",", TotalLoad(d):0:2, ",", WindCap(d):0:2, ",", P_wind.l(d):0:2, ",", Curtail_wind.l(d):0:2, ",", SolarCap(d):0:2, ",", P_solar.l(d):0:2, ",", Curtail_solar.l(d):0:2 /;
  81  );
  82  putclose results;


